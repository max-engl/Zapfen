# Copy to backend/.env and fill in real values. Never commit the result.

PORT=3000
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# Seed admin for the /admin panel
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# MongoDB — matches the credentials in docker-compose.yml for local dev
MONGO_URI=mongodb://admin:password123@localhost:27017/social_app?authSource=admin

# Any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Supabase storage (legacy — R2 is used in production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_POST_BUCKET=posts

# Cloudflare R2 — image storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AVATAR_BUCKET=
R2_POST_BUCKET=
R2_AVATAR_PUBLIC_BASE_URL=

# Resend — transactional email
RESEND_API_KEY=
